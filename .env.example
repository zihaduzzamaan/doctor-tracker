# Doctor Tracker: Environment Variables Template

# Frontend Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Database Configuration
# Local instance: mongodb://localhost:27017/doctor_tracker
# Atlas cluster: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/doctor_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/doctor_tracker

# Authentication (JWT)
JWT_SECRET=super-secure-jwt-secret-replace-in-production
JWT_EXPIRES_IN=7d
